<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<meta name="description" content="Bake Grills – Premium custom cakes in Ibadan. Birthday cakes, wedding cakes, cupcakes and celebration cakes. Order now! Orogun, Akinyele, Ibadan Oyo State."/>
<meta name="keywords" content="cakes in Ibadan, birthday cake Ibadan, custom cake Ibadan, Bake Grills, cupcakes Ibadan, wedding cake Ibadan, cake delivery Ibadan, Orogun Ibadan"/>
<title>Bake Grills – Cakes in Ibadan | Birthday, Wedding & Custom Cakes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Nunito:wght@300;400;500;600;700&family=Great+Vibes&display=swap" rel="stylesheet">
<style>
/* ── DESIGN SYSTEM ── */
:root{
  --p1:#f9e0da;--p2:#f2bdb5;--p3:#e8968a;--rose:#d4726a;
  --cream:#fdf6f0;--ivory:#fefaf5;--linen:#faf4ec;
  --g1:#c9a55a;--g2:#e8c97a;--g3:#f7ead8;
  --cocoa:#4e2e22;--brown:#7a4a38;--text:#3b2216;--tl:#7a5a4a;--mu:#b09080;
  --wh:#fff;--bdr:rgba(242,189,181,.42);
  --gr:linear-gradient(135deg,#f9e0da,#fdf6f0,#f2bdb5);
  --gg:linear-gradient(135deg,#c9a55a,#f7ead8,#e8c97a);
  --sh:0 4px 32px rgba(122,74,56,.1);--slg:0 14px 52px rgba(122,74,56,.17);
  --rad:18px;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--ivory);color:var(--text);font-family:'Nunito',sans-serif;font-weight:300;overflow-x:hidden;}
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:var(--cream);}
::-webkit-scrollbar-thumb{background:var(--p3);border-radius:4px;}

/* particles */
.pt{position:fixed;pointer-events:none;z-index:0;animation:ptf linear infinite;opacity:0;}
@keyframes ptf{0%{transform:translateY(100vh) rotate(0);opacity:0;}8%{opacity:.45;}90%{opacity:.15;}100%{transform:translateY(-60px) rotate(540deg);opacity:0;}}

/* WA FLOAT */
.waf{position:fixed;bottom:24px;right:24px;z-index:999;width:56px;height:56px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 22px rgba(37,211,102,.45);text-decoration:none;transition:transform .25s;animation:wap 2.8s ease-in-out infinite;}
.waf:hover{transform:scale(1.12);}
@keyframes wap{0%,100%{box-shadow:0 6px 22px rgba(37,211,102,.45);}50%{box-shadow:0 8px 34px rgba(37,211,102,.7);}}
.waf svg{fill:white;width:27px;height:27px;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:800;padding:15px 52px;display:flex;align-items:center;justify-content:space-between;background:rgba(254,250,245,.85);backdrop-filter:blur(20px) saturate(180%);border-bottom:1px solid var(--bdr);transition:padding .35s,box-shadow .35s;}
nav.sc{padding:9px 52px;box-shadow:0 2px 26px rgba(242,189,181,.2);}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;}
.lico{width:40px;height:40px;border-radius:50%;background:var(--gr);display:flex;align-items:center;justify-content:center;font-size:1.15rem;box-shadow:0 3px 10px rgba(232,150,138,.3);}
.ltxt{font-family:'Cormorant Garamond',serif;font-weight:700;font-size:1.15rem;color:var(--cocoa);letter-spacing:.03em;line-height:1.1;}
.ltxt small{display:block;font-size:.56rem;font-weight:400;letter-spacing:.18em;text-transform:uppercase;color:var(--mu);}
.nl{display:flex;align-items:center;gap:26px;list-style:none;}
.nl a{font-size:.71rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--tl);text-decoration:none;position:relative;padding-bottom:3px;transition:color .22s;}
.nl a::after{content:'';position:absolute;bottom:0;left:0;right:100%;height:1px;background:var(--p3);transition:right .28s;}
.nl a:hover{color:var(--cocoa);}.nl a:hover::after{right:0;}
.ncta{padding:9px 20px;background:var(--gr);color:var(--cocoa)!important;border-radius:100px;font-family:'Cormorant Garamond',serif!important;font-size:.78rem!important;font-weight:700!important;letter-spacing:.05em!important;text-transform:none!important;box-shadow:0 4px 14px rgba(232,150,138,.32);transition:transform .22s,box-shadow .22s!important;}
.ncta::after{display:none!important;}.ncta:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(232,150,138,.5)!important;}
.hb{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px;}
.hb span{display:block;width:22px;height:1.5px;background:var(--cocoa);border-radius:2px;transition:all .28s;}
.hb.op span:nth-child(1){transform:translateY(6.5px) rotate(45deg);}
.hb.op span:nth-child(2){opacity:0;}
.hb.op span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg);}

/* HERO */
#hero{min-height:100vh;display:flex;align-items:center;padding:120px 52px 80px;position:relative;overflow:hidden;background:linear-gradient(150deg,#fefaf5 0%,#fdf6f0 50%,#faf4ec 100%);}
.hdot{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(232,150,138,.1) 1.5px,transparent 1.5px);background-size:30px 30px;pointer-events:none;}
.hblob{position:absolute;border-radius:50%;pointer-events:none;animation:hbl 12s ease-in-out infinite alternate;}
.bl1{width:520px;height:520px;background:radial-gradient(circle,rgba(249,224,218,.42),transparent 68%);top:-160px;right:-120px;}
.bl2{width:340px;height:340px;background:radial-gradient(circle,rgba(201,165,90,.12),transparent 68%);bottom:-90px;left:-80px;animation-delay:6s;}
@keyframes hbl{from{transform:scale(1);}to{transform:scale(1.1) translate(16px,12px);}}
.hi{max-width:1160px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center;position:relative;z-index:2;}
.htag{display:inline-flex;align-items:center;gap:8px;font-size:.61rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--g1);margin-bottom:15px;opacity:0;animation:fu .8s .2s ease forwards;}
.htag::before,.htag::after{content:'\2736';font-size:.43rem;color:var(--p3);}
h1{font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,5vw,4.1rem);line-height:1.09;font-weight:700;color:var(--cocoa);margin-bottom:15px;opacity:0;animation:fu .9s .35s ease forwards;}
h1 em{color:var(--p3);font-style:italic;}
.hsub{font-size:.95rem;color:var(--tl);line-height:1.82;max-width:450px;margin-bottom:34px;opacity:0;animation:fu .9s .5s ease forwards;}
.hbtns{display:flex;gap:11px;flex-wrap:wrap;margin-bottom:42px;opacity:0;animation:fu .9s .65s ease forwards;}
.bp{padding:14px 30px;background:var(--gr);color:var(--cocoa);font-family:'Cormorant Garamond',serif;font-weight:700;font-size:.88rem;letter-spacing:.07em;border:none;border-radius:100px;text-decoration:none;box-shadow:0 6px 24px rgba(232,150,138,.42);transition:transform .26s,box-shadow .26s;cursor:pointer;}
.bp:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(232,150,138,.6);}
.bs{padding:13px 27px;border:1.5px solid rgba(201,165,90,.46);color:var(--brown);font-family:'Cormorant Garamond',serif;font-weight:700;font-size:.88rem;letter-spacing:.07em;border-radius:100px;text-decoration:none;background:transparent;transition:background .26s,transform .26s;}
.bs:hover{background:var(--g3);transform:translateY(-2px);}
.htrust{display:flex;gap:20px;flex-wrap:wrap;opacity:0;animation:fu .9s .8s ease forwards;}
.ti{display:flex;align-items:center;gap:7px;}
.ti span{font-size:.68rem;color:var(--tl);}
.ti strong{display:block;font-size:.72rem;color:var(--cocoa);font-weight:700;}
/* hero visual */
.hv{position:relative;opacity:0;animation:fi .9s .44s ease forwards;}
.cshape{width:100%;aspect-ratio:4/5;border-radius:42% 58% 55% 45%/40% 46% 54% 60%;overflow:hidden;background:var(--p1);box-shadow:var(--slg);animation:morp 13s ease-in-out infinite;}
.cshape img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
@keyframes morp{0%,100%{border-radius:42% 58% 55% 45%/40% 46% 54% 60%;}33%{border-radius:58% 42% 42% 58%/52% 58% 42% 48%;}66%{border-radius:48% 52% 34% 66%/58% 44% 56% 42%;}}
.fb{position:absolute;background:var(--wh);border-radius:14px;padding:11px 15px;box-shadow:0 8px 26px rgba(122,74,56,.18);display:flex;align-items:center;gap:9px;}
.fb1{top:-14px;right:-14px;}
.fb1 .fn{font-family:'Cormorant Garamond',serif;font-size:1.42rem;font-weight:900;color:var(--cocoa);line-height:1;}
.fb1 .fs{font-size:.68rem;color:#f59e0b;letter-spacing:2px;}
.fb1 .fl{font-size:.55rem;color:var(--mu);letter-spacing:.1em;text-transform:uppercase;}
.fb2{bottom:18px;left:-24px;}
.fb2 span{font-size:.67rem;color:var(--tl);}
.fb2 strong{display:block;font-size:.74rem;color:var(--cocoa);font-weight:700;}
.dr{position:absolute;border-radius:50%;border:1px dashed rgba(201,165,90,.3);animation:spn linear infinite;pointer-events:none;}
.dr1{width:106px;height:106px;top:-32px;left:11px;animation-duration:27s;}
.dr2{width:62px;height:62px;bottom:50px;right:-15px;animation-duration:18s;animation-direction:reverse;}
@keyframes spn{to{transform:rotate(360deg);}}
@keyframes fu{from{opacity:0;transform:translateY(19px);}to{opacity:1;transform:translateY(0);}}
@keyframes fi{from{opacity:0;transform:scale(.97);}to{opacity:1;transform:scale(1);}}

/* DIVIDERS */
.dv{display:flex;align-items:center;gap:12px;padding:8px 0;background:var(--ivory);}
.dl{flex:1;height:1px;background:linear-gradient(to right,transparent,var(--bdr),transparent);}
.di{font-size:.9rem;color:var(--p3);}

/* SECTIONS */
.sec{padding:84px 52px;}
.si{max-width:1160px;margin:0 auto;}
.ey{display:inline-block;font-size:.59rem;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:var(--g1);margin-bottom:9px;}
.ey::before{content:'\2014 ';}.ey::after{content:' \2014';}
.sh{font-family:'Cormorant Garamond',serif;font-size:clamp(1.7rem,3.7vw,2.85rem);font-weight:700;line-height:1.1;color:var(--cocoa);margin-bottom:10px;}
.sh em{font-style:italic;color:var(--p3);}
.gb{width:42px;height:2px;background:var(--gg);border-radius:2px;margin:12px 0 28px;}
.sub{font-size:.88rem;color:var(--tl);line-height:1.83;max-width:510px;}

/* ABOUT */
#about{background:var(--linen);}
.ag{display:grid;grid-template-columns:1fr 1fr;gap:66px;align-items:center;}
.aw{position:relative;}
.af::before{content:'';position:absolute;top:-8px;left:-8px;width:26px;height:26px;border-top:2px solid var(--g1);border-left:2px solid var(--g1);}
.af::after{content:'';position:absolute;bottom:-8px;right:-8px;width:26px;height:26px;border-bottom:2px solid var(--g1);border-right:2px solid var(--g1);}
.aim{width:100%;aspect-ratio:4/5;border-radius:var(--rad);overflow:hidden;box-shadow:var(--slg);background:var(--p1);}
.aim img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;transition:transform .55s;}
.aim:hover img{transform:scale(1.05);}
.asm{position:absolute;bottom:-18px;right:-18px;width:45%;aspect-ratio:1;border-radius:14px;overflow:hidden;border:4px solid var(--ivory);box-shadow:var(--sh);background:var(--p1);}
.asm img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
.abg{position:absolute;top:-13px;left:-13px;width:70px;height:70px;border-radius:50%;background:var(--g3);border:1px solid rgba(201,165,90,.2);display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-size:1.42rem;font-weight:900;color:var(--g1);line-height:1;}
.abg small{font-size:.41rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);}
.at p{font-size:.88rem;color:var(--tl);line-height:1.9;margin-bottom:11px;}
.at p strong{color:var(--cocoa);font-weight:600;}
.ast{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;margin-top:24px;}
.asn{text-align:center;padding:15px 8px;background:var(--ivory);border:1px solid var(--bdr);border-radius:13px;transition:transform .28s,box-shadow .28s;}
.asn:hover{transform:translateY(-4px);box-shadow:var(--sh);}
.asn span{font-family:'Cormorant Garamond',serif;font-size:1.8rem;font-weight:900;background:var(--gr);-webkit-background-clip:text;-webkit-text-fill-color:transparent;display:block;line-height:1;}
.asn small{font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mu);margin-top:3px;display:block;}

/* MENU */
#menu{background:var(--ivory);}
.mg{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:38px;}
.mc{border-radius:var(--rad);overflow:hidden;background:var(--wh);border:1px solid var(--bdr);box-shadow:0 2px 18px rgba(122,74,56,.07);transition:transform .3s,box-shadow .3s;cursor:pointer;}
.mc:hover{transform:translateY(-7px);box-shadow:var(--slg);}
.mi{width:100%;aspect-ratio:1;overflow:hidden;position:relative;}
.mi img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;transition:transform .46s;}
.mc:hover .mi img{transform:scale(1.08);}
.mlb{position:absolute;top:9px;left:9px;padding:3px 10px;border-radius:100px;font-size:.55rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;background:var(--wh);color:var(--rose);}
.minfo{padding:14px 16px;}
.mn{font-family:'Cormorant Garamond',serif;font-size:1rem;font-weight:700;color:var(--cocoa);margin-bottom:3px;}
.md{font-size:.73rem;color:var(--mu);line-height:1.57;}
.ma{display:flex;align-items:center;justify-content:space-between;margin-top:10px;}
.mtg{display:inline-block;padding:3px 10px;border-radius:100px;font-size:.57rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;background:var(--p1);color:var(--rose);}
.mb{padding:7px 14px;background:var(--gr);border:none;border-radius:100px;font-size:.67rem;font-weight:700;color:var(--cocoa);cursor:pointer;font-family:'Nunito',sans-serif;transition:transform .2s,box-shadow .2s;}
.mb:hover{transform:scale(1.05);box-shadow:0 4px 13px rgba(232,150,138,.38);}

/* GALLERY */
#gallery{background:var(--linen);}
.gh{text-align:center;margin-bottom:32px;}
.gg{display:grid;grid-template-columns:repeat(12,1fr);gap:11px;}
.gi{position:relative;overflow:hidden;border-radius:var(--rad);cursor:pointer;background:var(--p1);}
.gi:nth-child(1){grid-column:span 5;grid-row:span 2;}
.gi:nth-child(2){grid-column:span 4;}
.gi:nth-child(3){grid-column:span 3;}
.gi:nth-child(4){grid-column:span 4;}
.gi:nth-child(5){grid-column:span 3;}
.gi img{width:100%;height:100%;min-height:190px;object-fit:cover;object-position:center top;display:block;transition:transform .55s cubic-bezier(.25,.46,.45,.94);}
.gi:hover img{transform:scale(1.1);}
.gov{position:absolute;inset:0;background:linear-gradient(to top,rgba(78,46,34,.82) 0%,transparent 52%);opacity:0;transition:opacity .3s;display:flex;flex-direction:column;justify-content:flex-end;padding:17px;}
.gi:hover .gov{opacity:1;}
.gt{font-family:'Cormorant Garamond',serif;font-size:.95rem;font-weight:700;color:white;margin-bottom:3px;}
.gs{font-size:.68rem;color:rgba(255,255,255,.74);}
.gob{display:inline-block;margin-top:8px;padding:7px 15px;background:white;border-radius:100px;font-size:.64rem;font-weight:700;color:var(--cocoa);font-family:'Cormorant Garamond',serif;}

/* WHY */
#why{background:var(--ivory);}
.wg{display:grid;grid-template-columns:repeat(3,1fr);gap:17px;margin-top:42px;}
.wc{padding:29px 23px;background:var(--wh);border-radius:var(--rad);border:1px solid var(--bdr);transition:transform .3s,box-shadow .3s;position:relative;overflow:hidden;}
.wc::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gr);transform:scaleX(0);transform-origin:left;transition:transform .36s;}
.wc:hover::before{transform:scaleX(1);}.wc:hover{transform:translateY(-5px);box-shadow:var(--slg);}
.wico{width:49px;height:49px;border-radius:13px;background:var(--p1);margin-bottom:15px;display:flex;align-items:center;justify-content:center;font-size:1.38rem;}
.wc h3{font-family:'Cormorant Garamond',serif;font-size:1.04rem;font-weight:700;color:var(--cocoa);margin-bottom:7px;}
.wc p{font-size:.79rem;color:var(--tl);line-height:1.73;}

/* REVIEWS */
#reviews{background:var(--linen);}
.rbs{text-align:center;font-size:2.6rem;color:#f59e0b;letter-spacing:4px;margin-bottom:5px;}
.rc{text-align:center;margin-bottom:38px;}
.rn{font-family:'Cormorant Garamond',serif;font-size:3.6rem;color:var(--cocoa);line-height:1;}
.rl{font-size:.69rem;letter-spacing:.16em;text-transform:uppercase;color:var(--mu);}
.rg{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;}
.rv{padding:25px;background:var(--wh);border-radius:var(--rad);border:1px solid var(--bdr);transition:transform .28s,box-shadow .28s;}
.rv:hover{transform:translateY(-4px);box-shadow:var(--sh);}
.rq{font-family:'Great Vibes',cursive;font-size:2.8rem;line-height:.5;color:var(--p3);opacity:.55;display:block;margin-bottom:8px;}
.rv p{font-size:.83rem;color:var(--tl);line-height:1.8;font-style:italic;margin-bottom:15px;}
.rau{display:flex;align-items:center;gap:10px;}
.rav{width:37px;height:37px;border-radius:50%;background:var(--gr);display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;font-weight:700;font-size:.8rem;color:var(--cocoa);flex-shrink:0;}
.ran{display:block;font-size:.8rem;font-weight:700;color:var(--cocoa);}
.ral{font-size:.62rem;color:var(--mu);letter-spacing:.07em;}
.ras{font-size:.63rem;color:#f59e0b;}

/* ORDER */
#order{background:linear-gradient(155deg,#fefaf5,var(--linen));}
.og{display:grid;grid-template-columns:1fr 1.25fr;gap:58px;align-items:start;}
.cl{display:flex;flex-direction:column;gap:11px;margin-top:22px;}
.clk{display:flex;align-items:center;gap:12px;padding:13px 16px;border-radius:13px;text-decoration:none;border:1.5px solid;transition:transform .25s,background .25s,box-shadow .25s;position:relative;overflow:hidden;}
.clk::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--lc,var(--p3));transform:scaleY(0);transform-origin:top;transition:transform .27s;}
.clk:hover::before{transform:scaleY(1);}.clk:hover{transform:translateX(5px);}
.cico{width:40px;height:40px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.15rem;}
.clk strong{display:block;font-size:.79rem;font-weight:700;color:var(--cocoa);margin-bottom:1px;}
.clk span{font-size:.71rem;color:var(--tl);}
.cwa{border-color:rgba(37,211,102,.28);background:rgba(37,211,102,.04);--lc:#22c55e;}
.cwa:hover{box-shadow:0 5px 20px rgba(37,211,102,.18);}
.cwa .cico{background:rgba(37,211,102,.1);color:#22c55e;}
.cph{border-color:var(--bdr);background:rgba(249,224,218,.15);--lc:var(--p3);}
.cph:hover{box-shadow:var(--sh);}
.cph .cico{background:var(--p1);color:var(--rose);}
.cig{border-color:rgba(201,165,90,.26);background:rgba(201,165,90,.05);--lc:var(--g1);}
.cig:hover{box-shadow:0 5px 20px rgba(201,165,90,.16);}
.cig .cico{background:rgba(201,165,90,.12);color:var(--g1);}
.fcard{background:var(--wh);border-radius:var(--rad);padding:36px;border:1px solid var(--bdr);box-shadow:var(--sh);}
.ftt{font-family:'Cormorant Garamond',serif;font-size:1.32rem;font-weight:700;color:var(--cocoa);margin-bottom:4px;}
.fst{font-size:.77rem;color:var(--mu);margin-bottom:23px;}
.ff{display:flex;flex-direction:column;gap:12px;}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.fg{display:flex;flex-direction:column;gap:4px;}
.fg label{font-size:.58rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--mu);}
.fg input,.fg textarea,.fg select{background:var(--cream);border:1.5px solid var(--bdr);border-radius:9px;padding:10px 13px;color:var(--text);font-family:'Nunito',sans-serif;font-size:.85rem;outline:none;transition:border-color .22s,background .22s;}
.fg input:focus,.fg textarea:focus,.fg select:focus{border-color:var(--p3);background:var(--wh);}
.fg input::placeholder,.fg textarea::placeholder{color:rgba(160,128,120,.48);}
.fg textarea{resize:vertical;min-height:86px;}
.fg select option{background:var(--cream);}
.fsb{padding:13px;background:var(--gr);color:var(--cocoa);font-family:'Cormorant Garamond',serif;font-weight:700;font-size:.87rem;letter-spacing:.09em;border:none;border-radius:100px;cursor:pointer;width:100%;box-shadow:0 5px 22px rgba(232,150,138,.36);transition:transform .25s,box-shadow .25s;}
.fsb:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(232,150,138,.5);}

/* LOCATION */
#location{background:var(--linen);}
.lg{display:grid;grid-template-columns:1fr 1.5fr;gap:50px;align-items:center;}
.lis{display:flex;flex-direction:column;gap:16px;margin-top:22px;}
.li{display:flex;gap:12px;align-items:flex-start;}
.lic{width:40px;height:40px;border-radius:10px;flex-shrink:0;background:var(--p1);display:flex;align-items:center;justify-content:center;font-size:1.06rem;}
.li strong{display:block;font-size:.79rem;font-weight:700;color:var(--cocoa);margin-bottom:2px;}
.li p{font-size:.75rem;color:var(--tl);line-height:1.55;}
.mw{border-radius:var(--rad);overflow:hidden;border:1px solid var(--bdr);box-shadow:var(--sh);height:348px;}
.mw iframe{width:100%;height:100%;border:none;display:block;}

/* INSTA */
#insta{background:var(--ivory);}
.igs{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-top:28px;}
.igx{aspect-ratio:1;border-radius:13px;overflow:hidden;cursor:pointer;position:relative;}
.igx img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;transition:transform .38s;}
.igx:hover img{transform:scale(1.09);}
.igov{position:absolute;inset:0;background:rgba(78,46,34,.46);opacity:0;transition:opacity .27s;display:flex;align-items:center;justify-content:center;color:white;font-size:1.4rem;}
.igx:hover .igov{opacity:1;}
.igf{display:flex;justify-content:center;margin-top:20px;}
.igb{display:inline-flex;align-items:center;gap:8px;padding:12px 27px;border-radius:100px;background:linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);color:white;text-decoration:none;font-family:'Cormorant Garamond',serif;font-weight:700;font-size:.85rem;letter-spacing:.06em;box-shadow:0 5px 20px rgba(220,39,67,.26);transition:transform .25s,box-shadow .25s;}
.igb:hover{transform:translateY(-3px);box-shadow:0 9px 26px rgba(220,39,67,.4);}

/* FOOTER */
footer{background:var(--cocoa);color:rgba(253,240,235,.88);padding:56px 52px 25px;}
.fw{max-width:1160px;margin:0 auto;}
.fgd{display:grid;grid-template-columns:2.2fr 1fr 1fr 1.4fr;gap:40px;margin-bottom:40px;}
.fbn{font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:900;color:var(--g2);margin-bottom:9px;letter-spacing:.03em;}
.fbd{font-size:.77rem;color:rgba(253,240,235,.57);line-height:1.73;max-width:240px;}
.fsc{display:flex;gap:8px;margin-top:15px;}
.sl{width:32px;height:32px;border-radius:50%;background:rgba(253,240,235,.1);border:1px solid rgba(253,240,235,.13);display:flex;align-items:center;justify-content:center;font-size:.8rem;text-decoration:none;color:rgba(253,240,235,.7);transition:background .22s,transform .22s;}
.sl:hover{background:rgba(201,165,90,.3);transform:translateY(-2px);}
.fct{font-family:'Cormorant Garamond',serif;font-size:.9rem;font-weight:700;color:var(--g2);margin-bottom:12px;}
.fls{display:flex;flex-direction:column;gap:7px;}
.fls a{font-size:.74rem;color:rgba(253,240,235,.58);text-decoration:none;transition:color .2s;}
.fls a:hover{color:var(--g2);}
.fhr{display:flex;flex-direction:column;gap:7px;}
.fhr div{font-size:.73rem;color:rgba(253,240,235,.58);}
.fhr strong{color:rgba(253,240,235,.85);}
.fcl{display:flex;flex-direction:column;gap:8px;}
.fcl a{font-size:.74rem;color:rgba(253,240,235,.58);text-decoration:none;display:flex;align-items:center;gap:6px;transition:color .2s;}
.fcl a:hover{color:var(--g2);}
.fb{padding-top:20px;border-top:1px solid rgba(253,240,235,.1);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:9px;}
.fcp{font-size:.64rem;color:rgba(253,240,235,.34);letter-spacing:.06em;}
.ftg{font-family:'Great Vibes',cursive;font-size:1.28rem;color:rgba(201,165,90,.5);}

/* REVEAL */
.rev{opacity:0;transform:translateY(20px);transition:opacity .68s ease,transform .68s ease;}
.rev.in{opacity:1;transform:translateY(0);}
.d1{transition-delay:.1s;}.d2{transition-delay:.2s;}.d3{transition-delay:.3s;}.d4{transition-delay:.4s;}

/* MOBILE */
@media(max-width:980px){
  nav{padding:11px 18px;}nav.sc{padding:7px 18px;}
  .nl{display:none;flex-direction:column;position:fixed;inset:0;background:rgba(254,250,245,.97);backdrop-filter:blur(22px);align-items:center;justify-content:center;gap:22px;z-index:1000;}
  .nl.op{display:flex;}.hb{display:flex;}
  .sec{padding:60px 18px;}#hero{padding:102px 18px 60px;}
  .hi,.ag,.og,.lg,.fgd{grid-template-columns:1fr;}
  .hv{order:-1;}.mg{grid-template-columns:1fr 1fr;}.wg{grid-template-columns:1fr;}
  .rg{grid-template-columns:1fr;}
  .gg{grid-template-columns:1fr 1fr;}.gi{grid-column:span 1!important;grid-row:span 1!important;}
  .igs{grid-template-columns:repeat(3,1fr);}
  footer{padding:40px 18px 20px;}.fgd{grid-template-columns:1fr 1fr;gap:24px;}
  .fr{grid-template-columns:1fr;}.ast{grid-template-columns:1fr 1fr;}
}
@media(max-width:500px){
  .mg{grid-template-columns:1fr;}.igs{grid-template-columns:repeat(2,1fr);}
  .fgd{grid-template-columns:1fr;}.htrust{flex-direction:column;gap:9px;}
}
</style>
